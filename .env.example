# Copy this file to .env.local and fill in your key(s).

# Required — the companion's brain. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-key-here

# Optional — which model to use (defaults to claude-sonnet-5).
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional — live product/price data. Pick ONE provider (Shopify is preferred if both are set).
# Without either, the advisor still works using its own knowledge; with one, verdicts quote
# current real prices.

# Option A (recommended) — Shopify Storefront API, grounds verdicts in a real store's live
# catalog. Get a token from a Shopify Partner dev store's Headless channel:
# Partner dashboard → dev store admin → Sales channels → add the "Headless" app → Create
# storefront → copy the PRIVATE access token (server-side; safer than the public one).
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your-private-storefront-token-here
# (or, if you only have the public one: SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-public-token-here)

# Option B — SerpApi Google Shopping, free tier 250 searches/mo. Broader (whole web, not one
# store's catalog). Get a key at https://serpapi.com/ → Your Account → API Key.
# SERPAPI_KEY=your-serpapi-key-here
